---
import { projects } from '../data/portfolio';
---

<section class="section portfolio" id="portfolio">
	<h2 class="title portfolio__title reveal">Portafolio</h2>

	<div class="cards">
		{
			projects.map((p, i) => (
				<article class="card box box--hover reveal" tabindex="0" style={`--reveal-delay:${(i % 3) * 0.12}s`}>
					<div class="card__media">
						{p.image ? (
							<img src={p.image} alt={p.title} class="card__img" loading="lazy" />
						) : (
							<div class="card__placeholder" aria-hidden="true">
								{p.tech.map((icon) => (
									<iconify-icon icon={icon} />
								))}
							</div>
						)}
					</div>

					<div class="card__panel">
						<h3 class="card__title">{p.title}</h3>
						<p class="card__description">{p.description}</p>
						<div class="card__tech">
							{p.tech.map((icon) => (
								<iconify-icon icon={icon} width="22" height="22" />
							))}
						</div>
						{(p.demo || p.repo) && (
							<div class="card__links">
								{p.demo && (
									<a href={p.demo} target="_blank" rel="noopener" class="btn card__btn">
										<iconify-icon icon="mdi:web" width="20" height="20" /> Demo
									</a>
								)}
								{p.repo && (
									<a href={p.repo} target="_blank" rel="noopener">
										<iconify-icon icon="fa:github-alt" width="20" height="20" /> Código
									</a>
								)}
							</div>
						)}
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	/* El padding inferior deja espacio a la onda que lleva a Contacto */
	.portfolio {
		background-color: var(--bg-alt);
		padding-top: 14rem;
		padding-bottom: 18rem;
	}

	.portfolio__title {
		margin-bottom: 6rem;
	}

	.cards {
		width: 100%;
		max-width: 1200px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 2rem;
	}

	.card {
		position: relative;
		height: 26rem;
		color: var(--text-color);
		overflow: hidden;
	}

	.card__media {
		height: 17rem;
		overflow: hidden;
	}

	.card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.5s;
	}

	.card__placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		font-size: 5rem;
		background-color: var(--bg);
		transition: transform 0.5s;
	}

	.card:hover .card__img,
	.card:hover .card__placeholder {
		transform: scale(1.08);
	}

	/* Panel que se desliza hacia arriba al pasar el cursor (o al enfocar la tarjeta con Tab).
	   En reposo solo se ve el título, centrado en la franja bajo los logos. */
	.card__panel {
		position: relative;
		min-height: 26rem;
		padding: 2.6rem 2rem 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
		background-color: var(--bg);
		border-top: 1px solid var(--edge);
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.card:hover .card__panel,
	.card:focus-within .card__panel {
		transform: translateY(-17rem);
	}

	.card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.card__title {
		font-family: var(--font-display);
		font-size: 1.9rem;
		font-weight: var(--weight-display);
		background: var(--gradient-primary) text;
		-webkit-text-fill-color: transparent;
	}

	/* Descripción y logos pequeños: ocultos en reposo, aparecen al deslizar el panel */
	.card__description,
	.card__tech,
	.card__links {
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.card:hover :is(.card__description, .card__tech, .card__links),
	.card:focus-within :is(.card__description, .card__tech, .card__links) {
		opacity: 1;
		transition-delay: 0.1s;
	}

	.card__description {
		font-size: 1.5rem;
		color: var(--text-muted);
	}

	.card__tech {
		display: flex;
		gap: 0.8rem;
	}

	.card__links {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 1.6rem;
	}

	.card__links a {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		transition: color 0.3s;
	}

	.card__links a:not(.btn):hover {
		color: var(--accent);
	}

	.card__btn {
		padding: 0.4rem 1.2rem;
	}
</style>
