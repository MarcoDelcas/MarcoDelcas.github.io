---
import { socials } from '../data/portfolio';

const cards = socials.map((s) => ({
	title: s.name,
	text: s.description,
	link: s.url,
	label: 'Visitar perfil',
	icon: s.icon,
}));
---

<section class="section contact" id="contact">
	<h2 class="title reveal">Contacto</h2>
	<div class="contact__grid">
		{
			cards.map((c, i) => (
				<a href={c.link} target="_blank" rel="noopener" class="card-social box box--hover reveal" style={`--reveal-delay:${i * 0.12}s`}>
					<h3 class="card-social__title">{c.title}</h3>
					<p>{c.text}</p>
					<span class={`btn card-social__link ${i % 2 ? "" : "btn--green"}`}>
						{c.label}
						<iconify-icon icon="iconamoon:link-external" width="18" height="18" />
					</span>
					<iconify-icon icon={c.icon} class="card-social__image" />
				</a>
			))
		}
	</div>
</section>

<style>
	.contact {
		background-color: var(--bg-deep);
		gap: 6rem;
		padding-top: 6rem;
	}

	.contact__grid {
		width: 100%;
		max-width: 1200px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
		gap: 2rem;
	}

	.card-social {
		position: relative;
		z-index: 0;
		min-height: 24rem;
		padding: 3rem 2.4rem;
		display: flex;
		flex-direction: column;
		gap: 1.4rem;
		font-size: 1.6rem;
		overflow: hidden;
	}

	.card-social p {
		max-width: 32rem;
	}

	.card-social__title {
		font-family: var(--font-display);
		font-size: 2.8rem;
		font-weight: var(--weight-display);
		background: var(--gradient-primary) text;
		-webkit-text-fill-color: transparent;
	}

	.card-social__link {
		margin-top: auto;
		align-self: flex-start;
	}

	/* Al pasar sobre la tarjeta, el botón se "presiona" */
	.card-social:hover .card-social__link {
		translate: 3px 3px;
		box-shadow: none;
	}

	/* Ícono grande que rota al pasar el cursor */
	.card-social__image {
		position: absolute;
		z-index: -1;
		top: 45%;
		left: 68%;
		font-size: 17rem;
		color: var(--surface);
		opacity: 1;
		transform: rotate(30deg);
		transition: all 0.3s linear;
	}

	.card-social:hover .card-social__image {
		top: 38%;
		left: 62%;
		opacity: 1;
		color: color-mix(in srgb, var(--accent) 35%, var(--bg));
		transform: rotate(0);
	}
</style>
